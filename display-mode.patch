diff --git a/modules/ii/bar/UtilButtons.qml b/modules/ii/bar/UtilButtons.qml
index 2391b1b..b2128a6 100644
--- a/modules/ii/bar/UtilButtons.qml
+++ b/modules/ii/bar/UtilButtons.qml
@@ -18,6 +18,32 @@ Item {
     implicitWidth: isMaterial && !root.vertical ? flow.implicitWidth : root.vertical ? Appearance.sizes.verticalBarWidth - 14 : flow.implicitWidth + 4
     implicitHeight: isMaterial && root.vertical ? flow.implicitHeight: isMaterial ? 32 : root.vertical ? flow.implicitHeight + 4 : Appearance.sizes.barHeight
 
+    function cycleDisplayMode() {
+        switch (Config.options.bar.utilButtons.displayMode) {
+        case "auto": Config.options.bar.utilButtons.displayMode = "120hz"; break;
+        case "120hz": Config.options.bar.utilButtons.displayMode = "60hz"; break;
+        default: Config.options.bar.utilButtons.displayMode = "auto"; break;
+        }
+        displayModeDebounce.restart()
+    }
+
+    function applyDisplayMode() {
+        const mode = Config.options.bar.utilButtons.displayMode
+        const stateFile = "${XDG_RUNTIME_DIR:-/tmp}/end4-display-mode"
+        const manualMode = mode === "120hz" ? "120hz" : "60hz"
+        const profile = mode === "120hz" ? "Builtin" : "Builtin 60hz"
+        const command = mode === "auto"
+            ? `printf '%s\\n' auto > "${stateFile}"; ac-power-profile --apply`
+            : `printf '%s\\n' ${manualMode} > "${stateFile}"; monique --switch-profile "${profile}"`
+        Quickshell.execDetached(["bash", "-c", command])
+    }
+
+    Timer {
+        id: displayModeDebounce
+        interval: 1000
+        onTriggered: root.applyDisplayMode()
+    }
+
     Flow {
         id: flow
         anchors.centerIn: parent
@@ -323,5 +349,34 @@ Item {
                 }
             }
         }
+
+        Loader {
+            active: Config.options.bar.utilButtons.showDisplayModeToggle
+            visible: active
+            sourceComponent: isMaterial ? displayModeM3 : legacyDisplayMode
+        }
+        Component {
+            id: displayModeM3
+            UtilButton {
+                label: Config.options.bar.utilButtons.displayMode === "auto" ? "AUTO"
+                    : Config.options.bar.utilButtons.displayMode === "120hz" ? "120" : "60"
+                onClicked: root.cycleDisplayMode()
+            }
+        }
+        Component {
+            id: legacyDisplayMode
+            CircleUtilButton {
+                implicitWidth: 42
+                onClicked: root.cycleDisplayMode()
+                StyledText {
+                    anchors.centerIn: parent
+                    text: Config.options.bar.utilButtons.displayMode === "auto" ? "AUTO"
+                        : Config.options.bar.utilButtons.displayMode === "120hz" ? "120" : "60"
+                    font.pixelSize: Appearance.font.pixelSize.small
+                    font.weight: Font.Medium
+                    color: Appearance.colors.colOnLayer2
+                }
+            }
+        }
     }
-}
\ No newline at end of file
