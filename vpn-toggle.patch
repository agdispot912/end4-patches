diff --git a/modules/ii/bar/VpnToggle.qml b/modules/ii/bar/VpnToggle.qml
new file mode 100644
index 0000000..c8588a5
--- /dev/null
+++ b/modules/ii/bar/VpnToggle.qml
@@ -0,0 +1,52 @@
+import QtQuick
+import Quickshell.Io
+import qs.modules.common
+
+Item {
+    id: root
+    visible: false
+
+    readonly property string connectionName: Config.options.bar.utilButtons.vpnConnection.trim()
+    readonly property bool configured: connectionName.length > 0
+    property bool active: false
+    property bool changing: toggleProcess.running
+
+    function refresh() {
+        if (!configured) {
+            active = false
+            return
+        }
+        stateProcess.exec(["nmcli", "-g", "GENERAL.STATE", "connection", "show", connectionName])
+    }
+
+    function toggle() {
+        if (!configured || changing) return
+        toggleProcess.exec(["nmcli", "connection", active ? "down" : "up", "id", connectionName])
+    }
+
+    onConnectionNameChanged: refresh()
+    Component.onCompleted: refresh()
+
+    // NetworkManager changes are delivered by nmcli monitor; no state polling is used.
+    Process {
+        id: monitorProcess
+        running: root.configured
+        command: ["nmcli", "monitor"]
+        stdout: SplitParser {
+            onRead: root.refresh()
+        }
+    }
+
+    Process {
+        id: stateProcess
+        stdout: StdioCollector {
+            id: stateCollector
+            onStreamFinished: root.active = stateCollector.text.trim() === "activated"
+        }
+    }
+
+    Process {
+        id: toggleProcess
+        onExited: root.refresh()
+    }
+}
